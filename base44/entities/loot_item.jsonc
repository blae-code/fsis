{
  "name": "loot_item",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "Full item name, e.g. Hurston Dynamics S3 Shield Generator"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "fps_gear",
        "weapon",
        "ship_component",
        "vehicle_component",
        "bulk_cargo"
      ],
      "default": "ship_component",
      "description": "Category of the looted item"
    },
    "condition_pct": {
      "type": "number",
      "default": 100,
      "description": "Item condition percentage 0–100"
    },
    "condition_grade": {
      "type": "string",
      "enum": [
        "new",
        "refurb",
        "used",
        "worn"
      ],
      "default": "used",
      "description": "Condition tier derived from condition_pct"
    },
    "size_class": {
      "type": "string",
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "M",
        "L",
        "XL",
        "N/A"
      ],
      "default": "N/A",
      "description": "Size class for ship/vehicle components"
    },
    "manufacturer": {
      "type": "string",
      "description": "Item manufacturer, e.g. Aegis, Hurston Dynamics, Klaus & Werner"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Number of units looted"
    },
    "source_op": {
      "type": "string",
      "description": "Operation where this was looted, e.g. 'Reclaimer op Aaron Halo', 'Bounty vs GrimHex'"
    },
    "source_location": {
      "type": "string",
      "description": "Location looted from, e.g. Aaron Halo, Cellin, NPC ship wreck"
    },
    "crew_handle": {
      "type": "string",
      "description": "Crew member who looted or recovered this item"
    },
    "work_order_id": {
      "type": "string",
      "description": "Linked work order for crew share attribution"
    },
    "compatible_ships": {
      "type": "array",
      "description": "Ships this component fits, e.g. ['Cutlass Black', 'Freelancer']",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "raw",
        "repairing",
        "repaired",
        "listed",
        "sold",
        "scrapped"
      ],
      "default": "raw",
      "description": "Processing pipeline status"
    },
    "linked_product_id": {
      "type": "string",
      "description": "Product entity id once listed on storefront"
    },
    "est_sell_auec": {
      "type": "number",
      "description": "Estimated sell price in aUEC"
    },
    "actual_sell_auec": {
      "type": "number",
      "description": "Actual sale price once sold"
    },
    "notes": {
      "type": "string"
    },
    "operation_session_id": {
      "type": "string",
      "description": "The run this came off. Without it there is no per-run yield and no honest answer to 'was that worth flying'"
    },
    "acquisition_cost_auec": {
      "type": "number",
      "default": 0,
      "description": "What the collective actually paid for this. A FIELD, because it used to live inside a prose sentence in notes — so the one question any scrapyard asks first, did we make anything on that, could not be answered without reading English item by item. Zero for salvage we went and got ourselves, where the cost was crew time rather than credits, and for consigned stock, which was never our money"
    },
    "acquisition_source": {
      "type": "string",
      "enum": [
        "salvage",
        "buyback",
        "consignment",
        "fabrication",
        "other"
      ],
      "default": "salvage",
      "description": "How it came to be ours. Each carries a different cost basis and a different risk: salvage costs time, buyback costs cash up front, consignment costs nothing and is not ours to count"
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it landed on the shelf. Stock that does not turn is cash the collective cannot use, and nothing could measure how long anything had been sitting"
    },
    "consignor_user_id": {
      "type": "string",
      "description": "Whose it is, where the yard is selling it on somebody else's behalf rather than having bought it"
    }
  },
  "required": [
    "item_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
