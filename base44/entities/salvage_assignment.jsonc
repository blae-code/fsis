{
  "name": "salvage_assignment",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "The salvage contract this piece of work belongs to"
    },
    "contract_title": {
      "type": "string",
      "description": "Title of that contract when the tasking was written, so the board still reads plainly if it is renamed"
    },
    "aspect": {
      "type": "string",
      "enum": [
        "scan",
        "tow",
        "strip",
        "munch",
        "haul",
        "sell",
        "escort",
        "repair"
      ],
      "default": "strip",
      "description": "Which part of the contract this hull is working. A contract is rarely one job \u2014 stripping, hauling and selling can run at once on different hulls"
    },
    "hull_id": {
      "type": "string",
      "description": "The fleet hull committed to this aspect"
    },
    "hull_callsign": {
      "type": "string"
    },
    "pilot_handle": {
      "type": "string",
      "description": "The comrade flying it. Empty means the seat is open and this aspect cannot be counted on"
    },
    "target": {
      "type": "string",
      "description": "The wreck, panel field or terminal this tasking concerns"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "underway",
        "done",
        "blocked",
        "dropped"
      ],
      "default": "planned"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "aspect"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}