{
  "name": "crew_operation",
  "type": "object",
  "properties": {
    "op_name": {
      "type": "string",
      "description": "Name of the scheduled operation, e.g. 'Aaron Halo sweep — Saturday'"
    },
    "brief": {
      "type": "string",
      "description": "What the operation involves and what comrades should bring"
    },
    "op_type": {
      "type": "string",
      "enum": [
        "salvage",
        "hauling",
        "escort",
        "mining",
        "recovery",
        "other"
      ],
      "default": "salvage"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the muster begins"
    },
    "duration_hours": {
      "type": "number",
      "default": 2,
      "description": "Expected length of the operation in hours"
    },
    "muster_location": {
      "type": "string",
      "description": "Where to gather, e.g. 'Port Tressler — Hangar 4'"
    },
    "ship": {
      "type": "string",
      "description": "Primary hull for the run"
    },
    "crew_needed": {
      "type": "number",
      "default": 2,
      "description": "How many hands the operation calls for"
    },
    "roles_wanted": {
      "type": "string",
      "description": "Roles the op needs, e.g. 'pilot, scraper, security'"
    },
    "pay_basis": {
      "type": "string",
      "enum": [
        "shares",
        "flat_credit"
      ],
      "default": "shares",
      "description": "shares = co-op members' pay day pool; flat_credit = a fixed sum paid directly, used for contractors"
    },
    "flat_credit_auec": {
      "type": "number",
      "default": 0,
      "description": "Fixed sum per hand when the operation is paid directly rather than in shares"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "mustering",
        "underway",
        "completed",
        "stood_down"
      ],
      "default": "scheduled"
    },
    "rsvps": {
      "type": "array",
      "description": "Comrades who have answered the muster",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "standing": {
            "type": "string"
          },
          "response": {
            "type": "string",
            "enum": [
              "in",
              "maybe",
              "out"
            ]
          },
          "note": {
            "type": "string"
          },
          "responded_at": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "The place this comrade came for, chosen by them"
          },
          "waitlisted": {
            "type": "boolean",
            "default": false,
            "description": "True when the place was already full. Not a refusal — a place in the queue, taken in the order answers arrived when somebody stands down"
          }
        }
      }
    },
    "posted_by_email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "role_slots": {
      "type": "array",
      "description": "The places this run calls for — one pilot, two scrapers — rather than a bare headcount. A statement of what the work needs, never an assignment: a comrade chooses their own place. Where none are stated the muster falls back to crew_needed as open places of no particular trade, so older musters still read sensibly",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "any",
              "pilot",
              "scraper",
              "gunner",
              "security",
              "hauler",
              "engineer",
              "medic"
            ],
            "default": "any"
          },
          "wanted": {
            "type": "number",
            "default": 1
          }
        }
      }
    },
    "stood_down_reason": {
      "type": "string",
      "description": "Why the run was called off, told to everyone who said they were coming. A muster that vanishes without a word wastes an evening somebody had set aside"
    },
    "reminders_sent": {
      "type": "array",
      "description": "Which notices have already gone out for this muster (t24, t1). Also the guard against telling everybody twice: the sweep claims these before it sends",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "op_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
