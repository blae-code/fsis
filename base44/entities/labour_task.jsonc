{
  "name": "labour_task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short name of the task, e.g. 'Strip hull panels — Reclaimer bay 2'"
    },
    "brief": {
      "type": "string",
      "description": "What the work actually involves, written plainly for the comrade doing it"
    },
    "category": {
      "type": "string",
      "enum": [
        "salvage",
        "hauling",
        "escort",
        "repair",
        "intake",
        "delivery",
        "admin",
        "other"
      ],
      "default": "salvage",
      "description": "Kind of labour this task calls for"
    },
    "priority": {
      "type": "string",
      "enum": [
        "routine",
        "elevated",
        "urgent"
      ],
      "default": "routine"
    },
    "status": {
      "type": "string",
      "enum": [
        "posted",
        "claimed",
        "submitted",
        "credited",
        "returned",
        "cancelled"
      ],
      "default": "posted",
      "description": "posted = open to the board; claimed = taken up; submitted = proof filed; credited = paid in full; returned = sent back for more work"
    },
    "agreed_credit_auec": {
      "type": "number",
      "default": 0,
      "description": "Full agreed payment for this task in aUEC, settled directly and never folded into the share pool"
    },
    "blocked_by": {
      "type": "array",
      "description": "Work that must be done before this can begin — 'haul after strip'. A prerequisite counts as met once it is credited, or once it is cancelled, because work that will now never happen must not block the yard forever",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Title of that task when the link was made, so a comrade can be told which work they are waiting on without a second lookup"
          }
        }
      }
    },
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "Whether prerequisites are still outstanding. Kept for the board to read; it is display only, and readiness is checked against the real prerequisites again at the moment work is claimed, so a stale flag can never let blocked work be taken up"
    },
    "hands_needed": {
      "type": "number",
      "default": 1,
      "description": "How many pairs of hands the work calls for. Work needing three scrapers is one task with three places, not three copies of the same brief"
    },
    "crew": {
      "type": "array",
      "description": "The comrades holding this work. Nobody is assigned — every hand here put themselves here, and may take themselves off",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "claimed_at": {
            "type": "string",
            "format": "date-time"
          },
          "released_at": {
            "type": "string",
            "description": "Set when a hand steps off. The entry is kept rather than deleted — the record of who held what is not rewritten"
          },
          "submitted_at": {
            "type": "string",
            "description": "When this hand filed their own account of the work"
          },
          "proof_notes": {
            "type": "string",
            "description": "This hand's own account of what they did"
          },
          "proof_file_url": {
            "type": "string"
          },
          "actual_hours": {
            "type": "number"
          },
          "credited_auec": {
            "type": "number",
            "description": "What this hand was actually settled, once the council credits the work"
          }
        }
      }
    },
    "crew_user_ids": {
      "type": "array",
      "description": "Accounts presently on the crew. Kept alongside `crew` because row-level security cannot reach inside an array of objects — this is what lets every hand read and update their own task, not only the lead",
      "items": {
        "type": "string"
      }
    },
    "crew_count": {
      "type": "number",
      "default": 0,
      "description": "How many hands are presently on. Also the compare-and-swap token: a claim states the count it believed and lands only if that is still true, so two comrades taking the last place at the same moment cannot both get it"
    },
    "assigned_user_id": {
      "type": "string",
      "description": "The lead hand — first to take the work up and still holding it. Mirrors crew[0] so anything that reads a task the old single-hand way still reads something true"
    },
    "assigned_handle": {
      "type": "string",
      "description": "Handle of the comrade who holds this task"
    },
    "assigned_email": {
      "type": "string"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Date the work is expected by"
    },
    "estimated_hours": {
      "type": "number",
      "description": "Hours the council reckons the work will take when posting it. Stated openly so a comrade can judge the offer against their own time before taking it up, rather than discovering the cost afterwards"
    },
    "actual_hours": {
      "type": "number",
      "description": "Hours the work actually took, filed by the comrade who did it. Their account of their own labour, not a figure measured over them — the estimate is what drifts, and this is what corrects it"
    },
    "location": {
      "type": "string",
      "description": "Where the work happens, e.g. 'Aaron Halo' or 'Port Tressler'"
    },
    "serves_type": {
      "type": "string",
      "enum": [
        "none",
        "order",
        "cargo_lot",
        "operation",
        "fab_project",
        "work_order"
      ],
      "default": "none",
      "description": "What this labour was for. Value does not appear from nowhere — it is made by hands, and this is the link that lets us say whose"
    },
    "serves_id": {
      "type": "string",
      "description": "Id of the thing this labour served"
    },
    "serves_name": {
      "type": "string",
      "description": "Name of that thing when the task was posted, so the link still reads plainly if it is later renamed or removed"
    },
    "proof_notes": {
      "type": "string",
      "description": "The worker's own account of what was done"
    },
    "proof_file_url": {
      "type": "string",
      "description": "Screenshot or manifest uploaded as proof of work"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by_email": {
      "type": "string",
      "description": "Council member who credited or returned the work"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string",
      "description": "Council's reasoning, visible to the worker"
    },
    "credited_auec": {
      "type": "number",
      "default": 0,
      "description": "Amount actually credited on settlement"
    },
    "posted_by_email": {
      "type": "string"
    },
    "template_id": {
      "type": "string",
      "description": "The standing brief this posting came from, if any, so the terms a task was posted under can always be traced back to where they were written"
    },
    "template_name": {
      "type": "string",
      "description": "Name of that brief when this was posted, kept readable even if the brief is later renamed or retired"
    },
    "notes": {
      "type": "string"
    },
    "review_escalated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When filed work was put over a quiet reviewer's head to the proprietor. Also the guard against escalating the same work twice"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "data.crew_user_ids": "{{user.id}}"
        },
        {
          "data.status": "posted"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.assigned_user_id": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "data.crew_user_ids": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
