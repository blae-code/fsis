{
  "name": "buyback_offer",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "ship_component",
        "vehicle_component",
        "fps_gear",
        "weapon",
        "bulk_cargo",
        "other"
      ],
      "default": "other"
    },
    "condition_grade": {
      "type": "string"
    },
    "condition_pct": {
      "type": "number"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "seller_user_id": {
      "type": "string"
    },
    "seller_handle": {
      "type": "string"
    },
    "market_reference_auec": {
      "type": "number",
      "default": 0,
      "description": "What the market was paying at the moment of appraisal. Recorded so the offer can be checked afterwards against the figure it was actually based on, rather than against today's market"
    },
    "market_reference_source": {
      "type": "string",
      "description": "Where that figure came from, so 'the market' is not an assertion"
    },
    "fraction_percent": {
      "type": "number",
      "default": 60,
      "description": "The fraction of market this offer actually represents, AFTER condition and standing. This is the figure the member receives and the figure they are told — never a headline rate that further arithmetic then quietly moved"
    },
    "offer_auec": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "An offer is good until this moment and no longer. Market prices move, and an offer that never expires is one the collective can be held to at a price that has stopped making sense"
    },
    "status": {
      "type": "string",
      "enum": [
        "offered",
        "accepted",
        "declined",
        "expired",
        "withdrawn"
      ],
      "default": "offered"
    },
    "appraised_by_email": {
      "type": "string"
    },
    "appraisal_notes": {
      "type": "string",
      "description": "How the council reached the figure, readable by the comrade being offered it"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    },
    "loot_item_id": {
      "type": "string",
      "description": "The stock record created when the offer was accepted, so an item can be followed from a member's hold to the shelf"
    },
    "evidence_image_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "base_fraction_percent": {
      "type": "number",
      "description": "The hall's plain rate before condition and standing, so the effective fraction can be taken apart and checked"
    },
    "condition_key": {
      "type": "string",
      "enum": [
        "new",
        "refurbished",
        "used",
        "worn"
      ],
      "description": "Condition as appraised, which takes a stated cut of the fraction rather than being folded silently into the number"
    },
    "condition_factor": {
      "type": "number",
      "description": "What that condition multiplied the rate by, recorded so an old offer still explains itself if the factors are later changed"
    },
    "standing_bonus_percent": {
      "type": "number",
      "default": 0,
      "description": "Points added for the seller's LABOUR standing — the collective returns value to those who make it. Small and bounded, never negative: a poor labour record is a matter for the standing ledger, not something taken out of what we pay a comrade for their own property. Never drawn from storefront buyer pricing tiers, which are an unrelated thing"
    },
    "basis": {
      "type": "string",
      "description": "The arithmetic in words, as shown to the member. An offer a comrade cannot check is a number they have to take on trust"
    }
  },
  "required": [
    "item_name",
    "seller_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.seller_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
