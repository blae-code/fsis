{
  "name": "salvage_scan",
  "type": "object",
  "properties": {
    "scan_type": {
      "type": "string",
      "enum": [
        "terminal",
        "contract",
        "ship-hud",
        "signature",
        "manifest",
        "other"
      ],
      "default": "terminal",
      "description": "What kind of in-game screen was analyzed"
    },
    "image_url": {
      "type": "string",
      "description": "Uploaded screenshot that was analyzed"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated human-readable summary of the scan"
    },
    "extracted_data": {
      "type": "object",
      "description": "Structured data extracted from the image by the AI/OCR pass",
      "additionalProperties": true
    },
    "detected_commodities": {
      "type": "array",
      "description": "Salvage commodities detected with quantities/prices",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "quantity_scu": {
            "type": "number"
          },
          "price_sell": {
            "type": "number"
          },
          "terminal_name": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "AI confidence in the extraction"
    },
    "auto_applied": {
      "type": "boolean",
      "default": false,
      "description": "True if the background agent applied this scan to inventory"
    },
    "applied_session_id": {
      "type": "string",
      "description": "Salvage session the agent updated"
    },
    "applied_session_name": {
      "type": "string",
      "description": "Name of the updated salvage session"
    },
    "applied_changes": {
      "type": "string",
      "description": "Human-readable summary of what the agent changed"
    },
    "operation_session_id": {
      "type": "string",
      "description": "The run this scan was taken on, so finds belong to the run that made them"
    },
    "cluster_name": {
      "type": "string",
      "description": "The wreck field this scan belongs to, e.g. 'Halo cluster 3' — so a field can be marked, worked and finished rather than rediscovered every time"
    },
    "worked_by_handle": {
      "type": "string",
      "description": "Who is presently working this field, so two hands do not fly to the same wreck"
    },
    "stripped": {
      "type": "boolean",
      "default": false,
      "description": "Whether this find has been worked out. A field nobody marked finished is a field somebody flies back to for nothing"
    }
  },
  "required": [
    "scan_type"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
