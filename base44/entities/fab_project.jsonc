{
  "name": "fab_project",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Operator-given name for this fabrication run"
    },
    "items": {
      "type": "array",
      "description": "Recipes queued in this project with desired quantities",
      "items": {
        "type": "object",
        "properties": {
          "recipe_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "gathering",
        "crafting",
        "complete"
      ],
      "default": "planning",
      "description": "Lifecycle status of the fabrication project"
    },
    "priority": {
      "type": "string",
      "enum": [
        "routine",
        "elevated",
        "urgent"
      ],
      "default": "routine",
      "description": "What the bench should pick up first when several runs are queued"
    },
    "assigned_handle": {
      "type": "string",
      "description": "The comrade working the bench on this run. Empty means nobody has taken it up"
    },
    "bench_location": {
      "type": "string",
      "description": "Where the work happens, e.g. a base fabricator or workbench"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When the finished goods are wanted by"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_name"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}