{
  "name": "item_spec",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "Canonical item name"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "fps_gear",
        "weapon",
        "ship_component",
        "vehicle_component",
        "bulk_cargo",
        "other"
      ],
      "default": "ship_component"
    },
    "size_class": {
      "type": "string",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S7",
        "S8",
        "S9",
        "S10",
        "S11",
        "S12",
        "XS",
        "S",
        "M",
        "L",
        "XL",
        "N/A"
      ],
      "default": "N/A",
      "description": "Component size. Runs to S12 because a Reclaimer — the yard’s own trade — carries components well past S5, which the old list stopped at"
    },
    "manufacturer": {
      "type": "string"
    },
    "grade": {
      "type": "string",
      "description": "In-game quality grade, e.g. A, B, C or Civilian, Military, Competition"
    },
    "compatible_ships": {
      "type": "array",
      "description": "Ships this fits",
      "items": {
        "type": "string"
      }
    },
    "base_value_auec": {
      "type": "number",
      "description": "Reference value at 100% condition in aUEC"
    },
    "description": {
      "type": "string"
    },
    "component_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "unknown"
      ],
      "default": "unknown",
      "description": "The component's GRADE in the game — a real thing and a real difference in price. Not condition: an A-grade part in poor shape and a D-grade part in good shape are different goods"
    },
    "component_class": {
      "type": "string",
      "enum": [
        "military",
        "civilian",
        "industrial",
        "competition",
        "stealth",
        "unknown"
      ],
      "default": "unknown",
      "description": "What the component is tuned for. Also priced differently, and missing from the app until now"
    }
  },
  "required": [
    "item_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
